APP_NAME="F & B Forst und Brennholz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fbforstundbrennholzgmbh.com


APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Hostinger SMTP (hPanel → Emails → Create mailbox, then paste password below)
# Port 465 + MAIL_SCHEME=smtps (SSL). Alternative: port 587 + MAIL_SCHEME=smtp
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@fbforstundbrennholzgmbh.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@fbforstundbrennholzgmbh.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=info@fbforstundbrennholzgmbh.com
MAIL_ADMIN_NAME="F & B Forst und Brennholz — Bestellannahme"
MAIL_EHLO_DOMAIN=fbforstundbrennholzgmbh.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# WhatsApp Floating-Button (internationale Nummer ohne + und ohne Leerzeichen, z. B. 41791234567)
CONTACT_WHATSAPP=4915255641834
CONTACT_WHATSAPP_TEXT="Guten Tag, ich habe eine Frage zu Ihren Produkten."

MERCHANT_FEED_TOKEN=
MERCHANT_CURRENCY=EUR
MERCHANT_TARGET_COUNTRY=DE
MERCHANT_CONTENT_LANGUAGE=de
MERCHANT_FEED_LABEL=DE
MERCHANT_DEFAULT_BRAND="F & B Forst und Brennholz"
MERCHANT_SHIPPING_PRICE=0
MERCHANT_SHIPPING_MIN_DAYS=2
MERCHANT_SHIPPING_MAX_DAYS=5
MERCHANT_RETURN_DAYS=14
MERCHANT_CUSTOMER_PAYS_RETURN_SHIPPING=true
MERCHANT_RETURN_SHIPPING_COST=19.90
# Keep false until every strike-through / sale_price pair is human-verified on the PDP.
MERCHANT_REFERENCE_PRICES_VERIFIED=false
FEED_CACHE_TTL=900
FEED_HANDLING_TIME_MIN=1
FEED_HANDLING_TIME_MAX=2
FEED_TRANSIT_TIME_MIN=1
FEED_TRANSIT_TIME_MAX=3

# Primary product ingestion: scheduled XML/TSV feed (no API required).
# Merchant Center → Products → Add data source → Scheduled fetch
# URL: https://YOUR-DOMAIN/feeds/google-merchant-de.xml
# Country: Germany (DE) | Language: German (de) | File: RSS 2.0 XML
# Optional API sync (leave disabled if using feed only):
MERCHANT_API_ENABLED=false
MERCHANT_ACCOUNT_ID=
MERCHANT_DATA_SOURCE_ID=
MERCHANT_API_CREDENTIALS=google/merchant-sa.json
MERCHANT_API_TIMEOUT=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=


SHOP_FX_CHF_EUR=1.093
SHOP_VAT_RATE=19
SHOP_VAT_ID=
SHOP_TAX_ID=
SHOP_MANAGING_DIRECTOR="Thomas Josef Freimann, Tobias Heinrich Boßle"

SHOP_CONTACT_EMAIL=info@fbforstundbrennholzgmbh.com
SHOP_CONTACT_PHONE=+4915255641834
SHOP_CONTACT_PHONE_DISPLAY="+49 1525 5641834"

